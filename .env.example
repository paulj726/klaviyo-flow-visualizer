# ================================================
# REQUIRED ENVIRONMENT VARIABLES
# ================================================

# Database Configuration
# ----------------------
# Direct connection for migrations (port 5432)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# Pooled connection for runtime queries (port 6543)
DATABASE_URL_POOLED=postgresql://postgres.[project-ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Supabase Authentication
# ----------------------
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Security
# --------
# Generate a secure 32-byte key: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-string-here

# ================================================
# OPTIONAL ENVIRONMENT VARIABLES
# ================================================

# Server Configuration
# -------------------
# Port for the Express server (defaults to 3000)
PORT=3000

# Screenshot Generation (via HCTI.io)
# -----------------------------------
# Sign up at https://htmlcsstoimage.com to get API credentials
# Without these, email screenshots won't be generated
HCTI_USER_ID=your-hcti-user-id
HCTI_API_KEY=your-hcti-api-key

# ================================================
# NOTES
# ================================================
#
# 1. DATABASE_URL vs DATABASE_URL_POOLED:
#    - Use DATABASE_URL (port 5432) for Prisma migrations
#    - Use DATABASE_URL_POOLED (port 6543) for runtime queries
#    - Railway should use DATABASE_URL_POOLED in production
#
# 2. ENCRYPTION_KEY:
#    - MUST be 32 bytes (64 hex characters)
#    - Keep this secret and never commit it
#    - Generate with: openssl rand -hex 32
#
# 3. Supabase Keys:
#    - NEXT_PUBLIC_SUPABASE_URL: Your project URL
#    - NEXT_PUBLIC_SUPABASE_ANON_KEY: Public anon key (safe to expose)
#
# 4. HCTI API (Optional):
#    - Required only for email screenshot generation
#    - App works without it but shows placeholders
#    - Free tier available at htmlcsstoimage.com
#
# 5. For Railway Deployment:
#    - All REQUIRED variables must be set
#    - Use the Railway dashboard to set these
#    - Never commit actual values to git