# Klaviyo API Configuration
KLAVIYO_API_KEY=your_private_api_key_here
PORT=3000

# HTML/CSS to Image API Configuration
# Get your API key from https://htmlcsstoimage.com
HCTI_USER_ID=your_user_id_here
HCTI_API_KEY=your_api_key_here

# Google Sheets API Configuration
# Create a service account at https://console.cloud.google.com/
# Download the JSON key file and paste its contents here as a single-line JSON string
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
